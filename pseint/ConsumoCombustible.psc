
	Algoritmo ConsumoCombustible
		Definir kilometros, litros, consumo Como Real
		
		Escribir "Ingrese la cantidad de kilómetros recorridos:"
		Leer kilometros
		
		Escribir "Ingrese la cantidad de combustible consumido en litros:"
		Leer litros
		
		consumo <- kilometros / litros
		
		Escribir "El consumo promedio es de: ", consumo, " kilómetros por litro"
FinAlgoritmo
