
	Algoritmo Cubo
		Definir lado, area, volumen Como Real
		
		Escribir "Ingrese la longitud de un lado del cubo:"
		Leer lado
		
		area <- lado * lado
		volumen <- lado * lado * lado
		
		Escribir "El área de una cara del cubo es: ", area
		Escribir "El volumen total del cubo es: ", volumen
FinAlgoritmo
